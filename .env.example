# Copy to .env (never commit .env) or export these in your shell.
DJANGO_DEBUG=true                  # false in any shared deployment
DJANGO_SECRET_KEY=change-me        # required when DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
